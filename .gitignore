*.[mM][sS][bB]
*.[eE][fF][tT]
*.[hH][dD][tT]
*.[tT][sS][tT]
*.[tT][gG][aA]
*.[dD][dD][sS]
*.[bB][iI][kK]
*.[eE][xX][eE]
*.[dD][lL][lL]
